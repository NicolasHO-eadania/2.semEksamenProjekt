<Window x:Class="_2.semEksamenProjekt.EventOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skema" Height="650" Width="1130"
        WindowStartupLocation="CenterScreen"
        Loaded="WindowLoaded">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- tabs -->
            <RowDefinition Height="Auto"/>
            <!-- pile navigation + uge label -->
            <RowDefinition Height="Auto"/>
            <!-- dag headers -->
            <RowDefinition Height="30"/>
            <!-- skemaet -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- tabs -->
        <TabControl Grid.Row="0">
            
        </TabControl>

        <!-- navigationsknapper øverst til venstre -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="&#x2190;" Width="30" Click="PreviousWeek_Click"/>
            <Button Content="&#x2302;" Width="30" Margin="4,0" Click="CurrentWeek_Click"/>
            <Button Content="&#x2192;" Width="30" Click="NextWeek_Click"/>
            <TextBlock x:Name="WeekLabel" VerticalAlignment="Center"
                       FontSize="14" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- dag headers -->
        <!-- 60 pixels + 7 * 150 pixels = 1110 pixels -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">

            <TextBlock Width="60"/>

            <Border Width="150" BorderBrush="Gray" BorderThickness="1,1,0,1">
                <TextBlock Text="Mandag" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <Border Width="150" BorderBrush="Gray" BorderThickness="0,1,0,1">
                <TextBlock Text="Tirsdag" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <Border Width="150" BorderBrush="Gray" BorderThickness="0,1,0,1">
                <TextBlock Text="Onsdag" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <Border Width="150" BorderBrush="Gray" BorderThickness="0,1,0,1">
                <TextBlock Text="Torsdag" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <Border Width="150" BorderBrush="Gray" BorderThickness="0,1,0,1">
                <TextBlock Text="Fredag" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <Border Width="150" BorderBrush="Gray" BorderThickness="0,1,0,1">
                <TextBlock Text="Lørdag" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <Border Width="150" BorderBrush="Gray" BorderThickness="0,1,1,1">
                <TextBlock Text="Søndag" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>

        </StackPanel>

        <!-- skema -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Orientation="Horizontal">

                <StackPanel x:Name="TimeColumn" Width="60"/>

                <Canvas x:Name="EventsCanvas"/>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
