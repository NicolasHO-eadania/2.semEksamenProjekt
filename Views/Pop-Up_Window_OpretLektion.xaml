<Window x:Class="_2.semEksamenProjekt.Views.Pop_Up_Window_OpretLektion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2.semEksamenProjekt.Views"
        mc:Ignorable="d"
        Title="Pop_Up_Window_OpretLektion" Height="440" Width="400">
    <Grid>
        <Label Content="Opret Lektion" HorizontalAlignment="Left" Margin="143,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>

        <Label Content="Titel" HorizontalAlignment="Left" Margin="81,40,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="LektionTitelBox" HorizontalAlignment="Left" Margin="81,65,0,0" VerticalAlignment="Top" Width="216"/>

        <Label Content="Flow" HorizontalAlignment="Left" Margin="81,88,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="LektionFlowCombo" HorizontalAlignment="Left" Margin="81,115,0,0" VerticalAlignment="Top" Width="216"/>

        <Label Content="Dag" HorizontalAlignment="Left" Margin="81,139,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="LektionDagCombo" HorizontalAlignment="Left" Margin="81,165,0,0" VerticalAlignment="Top" Width="216">
            <ComboBoxItem>Mandag</ComboBoxItem>
            <ComboBoxItem>Tirsdag</ComboBoxItem>
            <ComboBoxItem>Onsdag</ComboBoxItem>
            <ComboBoxItem>Torsdag</ComboBoxItem>
            <ComboBoxItem>Fredag</ComboBoxItem>
        </ComboBox>

        <Label Content="Start tid" HorizontalAlignment="Left" Margin="81,190,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="StartTidBox" HorizontalAlignment="Left" Margin="81,215,0,0" VerticalAlignment="Top" Width="100"/>

        <Label Content="Slut tid" HorizontalAlignment="Left" Margin="197,190,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="SlutTidBox" HorizontalAlignment="Left" Margin="197,215,0,0" VerticalAlignment="Top" Width="100"/>

        <Label Content="Indhold" HorizontalAlignment="Left" Margin="81,240,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="LektionIndholdBox" HorizontalAlignment="Left" Margin="56,265,0,0" VerticalAlignment="Top" 
         Width="277" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

        <Button Content="Opret Lektion" HorizontalAlignment="Left" Margin="81,370,0,0" VerticalAlignment="Top" Width="216" Click="OpretLektion_Click"/>
    </Grid>
</Window>
