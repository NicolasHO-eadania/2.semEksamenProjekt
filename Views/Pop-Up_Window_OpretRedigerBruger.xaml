<Window x:Class="_2.semEksamenProjekt.Pop_Up_Window_OpretRedigerBruger"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2.semEksamenProjekt"
        mc:Ignorable="d"
        Title="Pop_Up_Window_OpretRedigerBruger" Height="400" Width="300">
    <Grid>
        <Label Content="Opret Bruger" HorizontalAlignment="Left" Margin="98,23,0,0" VerticalAlignment="Top"/>
        <Label Content="Brugernavn" HorizontalAlignment="Left" Margin="94,108,0,0" VerticalAlignment="Top" Width="88"/>
        <Label Content="Adgangskode" HorizontalAlignment="Left" Margin="94,159,0,0" VerticalAlignment="Top" Width="88"/>
        <TextBox x:Name="OpretBrugerBox" HorizontalAlignment="Left" Margin="82,136,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="AdgangskodeBox" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Margin="82,190,0,0"/>
        <Button Content="Gem Bruger" HorizontalAlignment="Left" Margin="82,317,0,0" VerticalAlignment="Top" Width="120" Click="GemBruger_Click"/>
        <RadioButton x:Name="RolleAdministrativ" Content="Administrativ" HorizontalAlignment="Left" Margin="98,245,0,0" VerticalAlignment="Top" Width="120"/>
        <Label Content="Rolle" HorizontalAlignment="Left" Margin="120,214,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="RolleLærer" Content="Lærer" HorizontalAlignment="Left" Margin="98,265,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="RolleElev" Content="Elev" HorizontalAlignment="Left" Margin="98,285,0,0" VerticalAlignment="Top"/>
        <Label Content="Navn" HorizontalAlignment="Left" Margin="98,59,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="NavnBox" HorizontalAlignment="Left" Margin="82,85,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
    </Grid>
</Window>
