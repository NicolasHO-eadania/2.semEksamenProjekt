<UserControl x:Class="_2.semEksamenProjekt.Views.Side_Skema"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2.semEksamenProjekt.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl x:Name="MainTabs">

            <!-- SKEMA TAB -->
            <TabItem Header="Skema">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+ Opret Lektion" 
                            HorizontalAlignment="Right" Margin="0,5,5,5"
                            Click="OpretLektion_Click"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="SkemaGrid"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- FLOWS TAB -->
            <TabItem Header="Flows">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Venstre side - TreeView -->
                    <DockPanel Grid.Column="0" Margin="5">
                        <TextBlock DockPanel.Dock="Top" Text="Mine Flows" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TreeView x:Name="FlowTree" SelectedItemChanged="FlowTree_SelectedItemChanged"/>
                    </DockPanel>

                    <!-- Højre side - Indhold -->
                    <Grid Grid.Column="1" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Knap øverst højre -->
                        <Button Grid.Row="0" Content="+ Opret Flow"
                    HorizontalAlignment="Right" Margin="0,0,0,5"
                    Click="OpretFlow_Click"/>

                        <TextBlock x:Name="IndholdTitel" Grid.Row="1" FontSize="20" 
                       FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox x:Name="IndholdTekst" Grid.Row="2" TextWrapping="Wrap"
                     AcceptsReturn="True" IsReadOnly="True" Height="150"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <!-- Opret underflow (kun lærer) -->
                        <StackPanel x:Name="OpretUnderflowPanel" Grid.Row="3" 
                        Visibility="Collapsed">
                            <TextBox x:Name="UnderflowTitelBox" Width="200" Margin="0,0,0,5"/>
                            <TextBox x:Name="UnderflowTekstBox" Height="80" Margin="0,0,0,5"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
                            <Button Content="+ Gem underflow" Click="OpretUnderflow_Click" 
                        HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- FLOW OVERSIGT TAB -->
            <TabItem Header="Flow Oversigt">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Flow Oversigt" FontSize="16" 
                               FontWeight="Bold" Margin="10,10,0,5"/>

                    <ListView x:Name="FlowOversigt" Grid.Row="1" Margin="10">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Flow" Width="150" 
                                                DisplayMemberBinding="{Binding FlowNavn}"/>
                                <GridViewColumn Header="Underflow" Width="150" 
                                                DisplayMemberBinding="{Binding UnderflowNavn}"/>
                                <GridViewColumn Header="Indhold" Width="300" 
                                                DisplayMemberBinding="{Binding Tekst}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
