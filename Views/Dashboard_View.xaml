<UserControl x:Class="_2.semEksamenProjekt.Views.Dashboard_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2.semEksamenProjekt.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ListBox x:Name="BrugerListe" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="608,28,31,28"/>
        <ListBox x:Name="FlowListe" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="26,40,609,40"/>
        <Button x:Name="OpretBruger" Content="Opret Bruger" HorizontalAlignment="Left" Margin="473,30,0,0" VerticalAlignment="Top" Width="112" Click="OpretBruger_Click"/>
        <Button x:Name="RedigerBruger" Content="Rediger Bruger" HorizontalAlignment="Left" Margin="473,70,0,0" VerticalAlignment="Top" Width="112" Click="RedigerBruger_Click"/>
        <Button x:Name="SletBruger" Content="Slet Bruger" HorizontalAlignment="Left" Margin="473,115,0,0" VerticalAlignment="Top" Width="112" Click="SletBruger_Click"/>
        <Button x:Name="OpretFlow" Content="Opret Flow" HorizontalAlignment="Left" Margin="215,55,0,0" VerticalAlignment="Top" Width="87" Click="OpretFlow_Click"/>
        <Button x:Name="RedigerFlow" Content="Rediger Flow" HorizontalAlignment="Left" Margin="215,100,0,0" VerticalAlignment="Top" Width="87" Click="RedigerFlow_Click"/>
        <Button x:Name="SletFlow" Content="Slet Flow" HorizontalAlignment="Left" Margin="215,151,0,0" VerticalAlignment="Top" Width="87" Click="SletFlow_Click"/>
        <Button x:Name="TilmeldFlow" Content="Tilmeld Flow" HorizontalAlignment="Left" Margin="337,205,0,0" VerticalAlignment="Top" Width="107" Click="TilmeldFlow_Click"/>
        <Button x:Name="OpretLektion" Content="Opret Lektion" HorizontalAlignment="Left" Margin="337,259,0,0" VerticalAlignment="Top" Width="107" Click="OpretLektion_Click"/>

    </Grid>
</UserControl>
