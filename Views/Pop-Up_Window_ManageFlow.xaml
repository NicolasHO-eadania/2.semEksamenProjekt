<Window x:Class="_2.semEksamenProjekt.Pop_Up_Window_ManageFlow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2.semEksamenProjekt"
        mc:Ignorable="d"
        Title="Pop_Up_Window_ManageFlow" Height="420" Width="400">
    <Grid>
        <Label Content="Flow Management" HorizontalAlignment="Left" Margin="143,10,0,0" VerticalAlignment="Top"/>
        <Label Content="1 - Vælg Flow" HorizontalAlignment="Left" Margin="81,41,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="FlowComboBox" HorizontalAlignment="Left" Margin="81,71,0,0" VerticalAlignment="Top" Width="216" SelectionChanged="FlowComboBox_SelectionChanged"/>
        <Label Content="2 - Vælg Bruger" HorizontalAlignment="Left" Margin="81,93,0,0" VerticalAlignment="Top" Width="216"/>
        <ComboBox x:Name="BrugerComboBox" HorizontalAlignment="Left" Margin="81,124,0,0" VerticalAlignment="Top" Width="216"/>
        <Label Content="Flow Medlemmer" HorizontalAlignment="Left" Margin="56,156,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="MedlemmerListe" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="56,182,62,86"/>
        <Button Content="Tilmeld bruger til Flow" HorizontalAlignment="Left" Margin="42,335,0,0" VerticalAlignment="Top" Width="144" Click="Tilmeld_Click"/>
        <Button Content="Afmeld bruger fra flow" HorizontalAlignment="Left" Margin="221,335,0,0" VerticalAlignment="Top" Width="144" Click="Afmeld_Click"/>

    </Grid>
</Window>
