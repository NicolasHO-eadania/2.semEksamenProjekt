<Window x:Class="_2.semEksamenProjekt.Pop_Up_Window_OpretFlow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2.semEksamenProjekt"
        mc:Ignorable="d"
        Title="Pop_Up_Window_OpretFlow" Height="400" Width="300">
    <Grid>
        <Label Content="Flow opret / redigere" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top"/>
        <Label Content="Titel" HorizontalAlignment="Left" Margin="90,72,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="Flow_Titel" HorizontalAlignment="Center" Margin="0,98,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Beskrivelse" HorizontalAlignment="Left" Margin="90,137,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="Flow_Beskrivelse" HorizontalAlignment="Center" Margin="0,163,0,0" TextWrapping="Wrap" AcceptsReturn="True" VerticalAlignment="Top" Width="185" Height="71"/>
        <Button Content="Gem Flow" HorizontalAlignment="Center" Margin="0,302,0,0" VerticalAlignment="Top" Width="120" Click="FlowGem_Click"/>

    </Grid>
</Window>
