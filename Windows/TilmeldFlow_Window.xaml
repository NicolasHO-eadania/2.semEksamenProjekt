<Window x:Class="_2.semEksamenProjekt.Windows.TilmeldFlow_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2.semEksamenProjekt.Windows"
        mc:Ignorable="d"
        Title="Tilmeld Flow" Height="400" Width="400"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Vælg Flow"/>
        <ComboBox Grid.Row="1" x:Name="CmbFlow" Height="30" Margin="0,0,0,10"
                  SelectionChanged="CmbFlow_SelectionChanged"/>

        <Label Grid.Row="2" Content="Vælg Bruger"/>
        <ComboBox Grid.Row="3" x:Name="CmbBruger" Height="30" Margin="0,0,0,10"/>

        <Label Grid.Row="4" Content="Tilmeldte brugere"/>
        <ListBox Grid.Row="5" x:Name="TilmeldteListe" Margin="0,4,0,10"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Tilmeld" Height="34" Click="Tilmeld_Click"/>
            <Button Grid.Column="2" Content="Afmeld"  Height="34" Click="Afmeld_Click"/>
        </Grid>
    </Grid>
</Window>