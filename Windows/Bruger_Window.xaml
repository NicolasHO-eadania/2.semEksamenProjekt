<Window x:Class="_2.semEksamenProjekt.Windows.Bruger_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2.semEksamenProjekt.Windows"
        mc:Ignorable="d"
        Title="Opret Bruger" Height="450" Width="800">
    <Grid>
        <Label Content="Navn" HorizontalAlignment="Left" Margin="44,68,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TxtNavn" HorizontalAlignment="Left" Margin="44,94,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label Content="Brugernavn" HorizontalAlignment="Left" Margin="44,136,0,0" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="TxtBrugernavn" HorizontalAlignment="Left" Margin="44,162,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label Content="Adgangskode" HorizontalAlignment="Left" Margin="44,0,0,0" VerticalAlignment="Center" Width="120"/>
        <TextBox x:Name="TxtPassword" HorizontalAlignment="Left" Margin="44,235,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label Content="Rolle" HorizontalAlignment="Left" Margin="44,268,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="RbElev"  Content="Elev"           HorizontalAlignment="Left" Margin="44,299,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="RbLærer" Content="Lærer"          HorizontalAlignment="Left" Margin="44,319,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="RbAdmin" Content="Administration" HorizontalAlignment="Left" Margin="44,339,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="TxtTitel" Margin="44,30,0,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Top"/>
        <Button x:Name="BtnGem" Content="Opret" HorizontalAlignment="Left" Margin="44,368,0,0" VerticalAlignment="Top" Width="120" Click="BtnGem_Click"/>
    </Grid>
</Window>