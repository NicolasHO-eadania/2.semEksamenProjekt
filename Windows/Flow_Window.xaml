        <TextBox x:Name="TxtNavn" HorizontalAlignment="Left" Margin="133,122,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label Content="Beskrivelse" HorizontalAlignment="Left" Margin="133,161,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TxtBeskrivelse" HorizontalAlignment="Left" Margin="133,192,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="Gem" Content="Gem" HorizontalAlignment="Left" Margin="133,234,0,0" VerticalAlignment="Top" Width="120" Click="BtnGem_Click"/>
